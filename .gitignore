# Unity 6 project .gitignore
# Commit Assets/, ProjectSettings/ and Packages/ — everything else Unity regenerates.

# ----- Unity generated -----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta files must be kept: a .meta is only ignored when its asset is too.
!/[Aa]ssets/**/*.meta

# Autogenerated native plugin and Addressables output
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Autogenerated Android assets
/[Aa]ssets/[Pp]lugins/[Aa]ndroid/*.androidlib/
/[Aa]ssets/[Ss]treamingAssets/[Aa]ndroid/

# ----- IDE / solution files (regenerated on open) -----
.vscode/
.idea/
.vs/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
ExportedObj/
.consulo/

# ----- Build artefacts -----
*.apk
*.aab
*.app
*.ipa
*.unitypackage
*.unitypackage.meta
crashlytics-build.properties
sysinfo.txt

# ----- OS cruft -----
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ----- Local tooling state (never belongs in the repo) -----
.omc/
.claude/
